{
    // ==============================
    //  General Settings
    // ==============================
    "position": "top",
    "height": 30,
    "width": "auto",
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,

    // ==============================
    //  Modules
    // ==============================
    "modules-left": [
        "sway/workspaces",
        "sway/scratchpad"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "custom/separator",
//        "network",
        "custom/separator",
        "battery",
        "custom/separator",
        "clock"
    ],

    // ==============================
    //  Module Configurations
    // ==============================

    // Scratchpad
    "sway/scratchpad": {
        "format": " / SCRATCHPAD: {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    // Clock
    "clock": {
        "format": "{:%a %I:%M}"
    },

    // Battery
    "battery": {
        "states": {
            "warning": 30,
            "critical": 10
        },
        "format": "BATT: {capacity}%",
        "format-full": "full: {capacity}%",
        "format-charging": "CHARGING: {capacity}%",
        "format-plugged": "plugged: {capacity}%",
        "interval": 5
    },

    // Network
    "network": {
        "format-wifi": "WIFI: {essid}",
        "format-ethernet": "ETH: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-disconnected": "disconnected",
        "format-disabled": "disabled"
    },

    // Audio (PulseAudio)
    "pulseaudio": {
        "scroll-step": 5,
        "format": "VOL: {volume}%",
        "format-bluetooth": "VOL: {volume}%",
        "max-volume": 100
    },

    // Custom Separator
    "custom/separator": {
        "format": " / "
    }
}

